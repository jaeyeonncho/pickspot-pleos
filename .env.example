# Server-side only. Copy to .env.local and enter the TMAP key locally.
# Never include this key in Android resources or browser JavaScript.
TMAP_APP_KEY=
# Local daily request cap, reset at 00:00 Korea time. 0 disables real requests.
# Choose a positive cap only after checking your account limits and pricing.
TMAP_DAILY_CALL_LIMIT=0
