<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/candidates_title" style="@style/Text.Heading"/>
    <LinearLayout android:id="@+id/preferences" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="@dimen/content_gap">
        <Button android:id="@+id/less_walk" style="@style/Widget.Pickspot.Button.Preference" android:text="@string/less_walk" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/balanced" style="@style/Widget.Pickspot.Button.Preference" android:text="@string/balanced" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/less_detour" style="@style/Widget.Pickspot.Button.Preference" android:text="@string/less_detour" android:layout_width="0dp" android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/candidate_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <TextView android:id="@+id/empty_candidates" style="@style/Text.Body" android:text="@string/empty_candidates" android:layout_marginTop="@dimen/section_gap" android:visibility="gone"/>
    <TextView android:id="@+id/ranking_note" style="@style/Text.Caption" android:layout_marginTop="@dimen/content_gap"/>
</LinearLayout>
