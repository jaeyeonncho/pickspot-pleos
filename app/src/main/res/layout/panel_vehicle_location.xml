<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="@dimen/card_padding" android:background="@drawable/panel_background"
    android:layout_marginTop="@dimen/section_gap">
    <TextView style="@style/Text.Heading" android:text="@string/vehicle_location_title"/>
    <TextView android:id="@+id/vehicle_location_status" style="@style/Text.Body"
        android:layout_marginTop="@dimen/content_gap" android:accessibilityLiveRegion="polite"/>
    <TextView android:id="@+id/vehicle_location_details" style="@style/Text.Caption"
        android:layout_marginTop="@dimen/content_gap" android:visibility="gone"/>
    <TextView style="@style/Text.Caption" android:text="@string/vehicle_location_note"
        android:layout_marginTop="@dimen/content_gap"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="@dimen/content_gap">
        <Button android:id="@+id/vehicle_location_start" style="@style/Widget.Pickspot.Button.Action"
            android:layout_width="wrap_content" android:text="@string/vehicle_location_start"/>
        <Button android:id="@+id/vehicle_location_stop" style="@style/Widget.Pickspot.Button.Action"
            android:layout_width="wrap_content" android:layout_marginStart="@dimen/content_gap"
            android:text="@string/vehicle_location_stop" android:visibility="gone"/>
    </LinearLayout>
    <Button android:id="@+id/vehicle_location_accuracy_check" style="@style/Widget.Pickspot.Button.Action"
        android:layout_marginTop="@dimen/content_gap" android:text="@string/vehicle_location_accuracy_check" android:visibility="gone" />
    <Button android:id="@+id/vehicle_sharing_check" style="@style/Widget.Pickspot.Button.Action"
        android:layout_marginTop="@dimen/content_gap" android:text="@string/vehicle_sharing_check" android:visibility="gone" />
</LinearLayout>
