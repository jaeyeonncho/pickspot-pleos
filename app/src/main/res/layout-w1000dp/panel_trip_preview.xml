<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="16dp">
            <TextView style="@style/Text.Heading" android:text="@string/trip_preview_title"/>
            <TextView style="@style/Text.Caption" android:text="@string/trip_preview_source"/>
            <TextView android:id="@+id/trip_preview_status" style="@style/Text.Body" android:minLines="2" android:layout_marginTop="8dp" android:text="@string/trip_preview_idle"/>
            <TextView android:id="@+id/trip_preview_age" style="@style/Text.Caption" android:minLines="1"/>
        </LinearLayout>
        <Button android:id="@+id/trip_preview_request" style="@style/Widget.Pickspot.Button.Action" android:text="@string/trip_preview_request" android:enabled="false"/>
    </LinearLayout>
    <TextView style="@style/Text.Caption" android:text="@string/dashboard_preview_note" android:layout_marginTop="8dp"/>
</LinearLayout>
