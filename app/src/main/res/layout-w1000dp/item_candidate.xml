<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/card_background" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/card_title" style="@style/Text.Heading" android:layout_width="0dp" android:layout_weight="1"/>
        <TextView android:id="@+id/card_badge" style="@style/Text.Caption" android:layout_width="wrap_content" android:textColor="@color/accent"/>
    </LinearLayout>
    <TextView android:id="@+id/card_metrics" style="@style/Text.Body" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/card_curb" style="@style/Text.Caption" android:layout_marginTop="8dp"/>
</LinearLayout>
