<resources>
    <style name="Theme.Pickspot" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/body_text</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Heading" parent="Text.Body">
        <item name="android:textSize">@dimen/heading_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Title" parent="Text.Heading">
        <item name="android:textSize">@dimen/title_text</item>
    </style>
    <style name="Text.Caption" parent="Text.Body">
        <item name="android:textSize">@dimen/caption_text</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="Widget.Pickspot.Button" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">10dp</item>
        <item name="android:minHeight">60dp</item>
    </style>
    <!-- Main-screen actions stay compact on a wide vehicle display. -->
    <style name="Widget.Pickspot.Button.Action" parent="Widget.Pickspot.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:maxWidth">320dp</item>
        <item name="android:minHeight">84dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Widget.Pickspot.Button.Preference" parent="Widget.Pickspot.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">84dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
