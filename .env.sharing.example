# HTTPS sharing server only. Copy to .env.sharing.local with file mode 600.
# Never put the driver key in browser/Android code or publish it.
PICKSPOT_PUBLIC_ORIGIN=
PICKSPOT_TLS_CERT_FILE=
PICKSPOT_TLS_KEY_FILE=
PICKSPOT_DRIVER_KEY=
PICKSPOT_SHARE_PORT=8443
# Loopback by default. Public binding is an explicit deployment decision.
PICKSPOT_BIND_ADDRESS=127.0.0.1
